# Search Gateway local deployment secrets and private TLS material
gateway/.env*
!gateway/.env.example
gateway/*.pem
gateway/*.key

# Realtime relay: the first Node service here with real dependencies, so it is
# also the first to produce a node_modules that must never be committed.
realtime/node_modules/
realtime/.env*
!realtime/.env.example

