.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

data/*.lock
# The development API-config Hive may contain credentials; never commit it.
data/api_configs.hive
# Debug-only plaintext credential mirror (macOS ad-hoc signing workaround).
data/dev_credentials.hive

# Symbolication / obfuscation
app.*.symbols
app.*.map.json

# Android build artifacts
/android/app/debug
/android/app/profile
/android/app/release

# Local assistant / workspace data
.claude/
.playwright-cli/
