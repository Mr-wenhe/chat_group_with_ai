# Required: select the only upstream this deployment may call.
SEARCH_PROVIDER=brave
BRAVE_API_KEY=replace-with-server-side-provider-key
# SEARCH_PROVIDER=tavily
# TAVILY_API_KEY=replace-with-server-side-provider-key

# Required in production. Supply one or more comma-separated application/user
# bearer tokens. Never put provider keys here.
GATEWAY_API_TOKENS=replace-with-long-random-client-token

# Optional browser access. Use only exact company HTTPS web origins; omit to
# disable CORS entirely for native/mobile-only deployments.
ALLOWED_ORIGINS=https://app.example.com

PORT=8080
REQUEST_TIMEOUT_MS=8000
RATE_LIMIT_PER_MINUTE=60

# Development only. Production refuses to start without GATEWAY_API_TOKENS.
ALLOW_UNAUTHENTICATED_DEV=false
