platform :osx, '10.15'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'ephemeral', 'Flutter-Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure \"flutter pub get\" is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Flutter-Generated.xcconfig, then run \"flutter pub get\""
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_macos_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_macos_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_macos_build_settings(target)
  end

  # desktop_webview_window 0.3.0 invokes the Dart URL callback but always
  # returns WKNavigationActionPolicy.allow on macOS.  The visible-browser
  # boundary must fail closed before a file:// URL can load, so patch the
  # pinned plugin source at pod-install time.  Keep this check strict: a
  # future plugin change must not silently remove the native security gate.
  webview_sources = Dir[
    File.expand_path(
      'Flutter/ephemeral/.symlinks/plugins/desktop_webview_window/macos/**/WebViewLayoutController.swift',
      __dir__,
    ),
  ]
  if webview_sources.empty?
    raise 'desktop_webview_window navigation controller source not found'
  end
  navigation_guard = 'guard ["http", "https", "file"].contains(url.scheme?.lowercased() ?? "") else {'
  secure_navigation_guard = 'guard ["http", "https"].contains(url.scheme?.lowercased() ?? "") else {'
  webview_sources.each do |source_path|
    source = File.read(source_path)
    if source.include?(navigation_guard)
      source = source.sub(navigation_guard, secure_navigation_guard)
    elsif !source.include?(secure_navigation_guard)
      raise "desktop_webview_window navigation guard was not found: #{source_path}"
    end
    # The plugin callback is also invoked for iframe navigations. A child
    # frame must not be allowed to replace the task's main-page URL (or load a
    # private endpoint) through the Dart callback, so reject non-main frames at
    # the native decision boundary.
    main_frame_guard = [
      '    guard navigationAction.targetFrame?.isMainFrame ?? true else {',
      '      decisionHandler(.cancel)',
      '      return',
      '    }',
      '',
    ].join("\n")
    if source.include?(main_frame_guard)
      # Already patched; keep pod install idempotent.
    elsif source.include?(secure_navigation_guard)
      source = source.sub(
        "#{secure_navigation_guard}\n      decisionHandler(.cancel)\n      return\n    }\n\n",
        "#{secure_navigation_guard}\n      decisionHandler(.cancel)\n      return\n    }\n\n#{main_frame_guard}",
      )
    else
      raise "desktop_webview_window secure navigation guard body was not found: #{source_path}"
    end
    # desktop_webview_window 0.3.0 ignores the Dart callback result on macOS
    # and unconditionally allows every http(s) navigation. Use the plugin's
    # existing method-channel result to make the Dart public-URL validator the
    # native decision boundary too; otherwise a blocked URL would still load.
    original_callback = [
      '    methodChannel.invokeMethod("onUrlRequested", arguments: [',
      '      "id": viewId,',
      '      "url": url.absoluteString,',
      '    ] as [String: Any])',
      '',
      '    decisionHandler(.allow)',
      '',
    ].join("\n")
    guarded_callback = [
      '    methodChannel.invokeMethod("onUrlRequested", arguments: [',
      '      "id": viewId,',
      '      "url": url.absoluteString,',
      '    ] as [String: Any]) { result in',
      '      let allow = (result as? NSNumber)?.boolValue == true',
      '      decisionHandler(allow ? .allow : .cancel)',
      '    }',
      '',
    ].join("\n")
    if source.include?(original_callback)
      source = source.sub(original_callback, guarded_callback)
    elsif !source.include?(guarded_callback)
      raise "desktop_webview_window URL callback body was not found: #{source_path}"
    end
    # WKUIDelegate's default plugin implementation loads target=_blank
    # requests directly and bypasses decidePolicyFor navigationAction. Block
    # such popups instead of giving them a second, unvalidated navigation
    # channel; the user can follow a normal in-page link after review.
    popup_loading = [
      '    if !(navigationAction.targetFrame?.isMainFrame ?? false) {',
      '      webView.load(navigationAction.request)',
      '    }',
      '    return nil',
    ].join("\n")
    popup_blocked = [
      '    // Popups are blocked so every navigation crosses the main-frame',
      '    // URL callback and public-endpoint validator.',
      '    return nil',
    ].join("\n")
    if source.include?(popup_loading)
      source = source.sub(popup_loading, popup_blocked)
    elsif !source.include?(popup_blocked)
      raise "desktop_webview_window popup navigation body was not found: #{source_path}"
    end
    File.write(source_path, source)
  end

  # ponytail: keep the adapter's foreground request compatible with the
  # pinned macOS plugin, whose Dart API exposes this method but whose native
  # switch was missing it in 0.3.0. A missing method used to close the window
  # immediately and turn a valid login/CAPTCHA handoff into a false failure.
  plugin_sources = Dir[
    File.expand_path(
      'Flutter/ephemeral/.symlinks/plugins/desktop_webview_window/macos/**/DesktopWebviewWindowPlugin.swift',
      __dir__,
    ),
  ]
  controller_sources = Dir[
    File.expand_path(
      'Flutter/ephemeral/.symlinks/plugins/desktop_webview_window/macos/**/WebviewWindowController.swift',
      __dir__,
    ),
  ]
  if plugin_sources.empty? || controller_sources.empty?
    raise 'desktop_webview_window foreground source not found'
  end

  foreground_case = [
    '    case "bringToForeground":',
    '      guard let argument = call.arguments as? [String: Any?] else {',
    '        result(FlutterError(code: "0", message: "arg is not map", details: nil))',
    '        return',
    '      }',
    '      guard let viewId = argument["viewId"] as? Int64 else {',
    '        result(FlutterError(code: "0", message: "param viewId not found", details: nil))',
    '        return',
    '      }',
    '      guard let wc = webviews[viewId] else {',
    '        result(FlutterError(code: "0", message: "can not find webview for id: \\(viewId)", details: nil))',
    '        return',
    '      }',
    '      wc.bringToForeground(maximized: argument["maximized"] as? Bool ?? false)',
    '      result(nil)',
    '      break',
  ].join("\n") + "\n"
  plugin_sources.each do |source_path|
    source = File.read(source_path)
    unless source.include?('case "bringToForeground":')
      marker = '    case "stop":'
      unless source.include?(marker)
        raise "desktop_webview_window foreground switch marker was not found: #{source_path}"
      end
      source = source.sub(marker, "#{foreground_case}#{marker}")
      File.write(source_path, source)
    end
  end

  foreground_method = [
    '',
    '  func bringToForeground(maximized: Bool) {',
    '    guard let window = window else { return }',
    '    if maximized && !window.isZoomed {',
    '      window.zoom(nil)',
    '    }',
    '    NSApp.activate(ignoringOtherApps: true)',
    '    window.makeKeyAndOrderFront(nil)',
    '    window.orderFrontRegardless()',
    '  }',
  ].join("\n") + "\n"
  controller_sources.each do |source_path|
    source = File.read(source_path)
    unless source.include?('func bringToForeground(maximized: Bool)')
      marker = '  func setAppearance(brightness: Int) {'
      unless source.include?(marker)
        raise "desktop_webview_window foreground method marker was not found: #{source_path}"
      end
      source = source.sub(marker, "#{foreground_method}#{marker}")
      File.write(source_path, source)
    end
  end
end
