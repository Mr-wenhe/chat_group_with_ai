# Shared secret every client must present as ?token=... on the WebSocket URL.
# Generate one with: node -e "console.log(require('node:crypto').randomUUID())"
REALTIME_SHARED_TOKEN=replace-me

# Not 9100: that is Dart DevTools' default port and collides on dev machines.
PORT=9210

# Liveness probe interval for half-open connections.
HEARTBEAT_INTERVAL_MS=30000

# How long an authenticated socket may stay connected without sending `join`.
JOIN_TIMEOUT_MS=10000

# Messages kept per room for late-joiner catch-up.
RECENT_MESSAGE_LIMIT=50
MAX_CONNECTIONS_PER_ROOM=50

# Local smoke testing only; rejected when NODE_ENV=production.
# ALLOW_UNAUTHENTICATED_DEV=true
